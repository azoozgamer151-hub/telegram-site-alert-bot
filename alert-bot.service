[Unit]
Description=Telegram site alert bot
After=network-online.target

[Service]
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/telegram-site-alert-bot
EnvironmentFile=/home/YOUR_USER/telegram-site-alert-bot/.env
ExecStart=/usr/bin/python3 -u alert_bot.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
